generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Bolig {
  id          Int      @id @default(autoincrement())
  tittel      String
  adresse     String
  by          String
  pris        Int?
  type        String
  storrelse   Int?
  rom         Int?
  bad         Int?
  beskrivelse String
  bilder      String   @default("[]")
  lat         Float?
  lng         Float?
  aktiv       Boolean  @default(true)
  opprettet   DateTime @default(now())
  oppdatert   DateTime @updatedAt
  status                      String    @default("til_salgs")
  kjopesum                     Int?
  kjopsdato                    DateTime?
  finansiering                 String?
  estimertVerdiNa              Int?
  estimertVerdiEtterOppussing  Int?
  salgssum                     Int?
  delprosjekter Delprosjekt[]
  kapitalinnskudd Kapitalinnskudd[]
  utgifter Utgift[]
}

model Innstilling {
  id                       Int   @id @default(1)
  arbeidstimerAndelProsent Float @default(10)
  kapitalAndelProsent      Float @default(10)
}

model AdminUser {
  id         Int      @id @default(autoincrement())
  brukernavn String   @unique
  passord    String
  navn       String
  rolle      String   @default("eier")
  opprettet  DateTime @default(now())
  timeregistreringer Timeregistrering[]
  kapitalinnskudd Kapitalinnskudd[]
  utgifterBetalt Utgift[] @relation("UtgiftBetaltAv")
}

model Delprosjekt {
  id          Int      @id @default(autoincrement())
  eiendomId   Int
  eiendom     Bolig    @relation(fields: [eiendomId], references: [id])
  navn        String
  beskrivelse String?
  budsjett    Int?
  status      String   @default("planlagt")
  opprettet   DateTime @default(now())
  oppdatert   DateTime @updatedAt
  timeregistreringer Timeregistrering[]
  utgifter Utgift[]
}

model Timeregistrering {
  id            Int         @id @default(autoincrement())
  delprosjektId Int
  delprosjekt   Delprosjekt @relation(fields: [delprosjektId], references: [id])
  brukerId      Int
  bruker        AdminUser   @relation(fields: [brukerId], references: [id])
  dato          DateTime
  antallTimer   Float
  beskrivelse   String?
  opprettet     DateTime    @default(now())
  oppdatert     DateTime    @updatedAt
}

model Kapitalinnskudd {
  id          Int       @id @default(autoincrement())
  eiendomId   Int
  eiendom     Bolig     @relation(fields: [eiendomId], references: [id])
  brukerId    Int
  bruker      AdminUser @relation(fields: [brukerId], references: [id])
  dato        DateTime
  belop       Int
  beskrivelse String?
  opprettet   DateTime  @default(now())
}

model Utgift {
  id                  Int          @id @default(autoincrement())
  eiendomId           Int
  eiendom             Bolig        @relation(fields: [eiendomId], references: [id])
  delprosjektId       Int?
  delprosjekt         Delprosjekt? @relation(fields: [delprosjektId], references: [id])
  dato                DateTime
  kategori            String
  beskrivelse         String?
  leverandor          String?
  belop               Int
  betaltAvBrukerId    Int?
  betaltAvBruker      AdminUser?   @relation("UtgiftBetaltAv", fields: [betaltAvBrukerId], references: [id])
  kvitteringBilde     Bytes?
  kvitteringMimeType  String?
  opprettet           DateTime     @default(now())
}

model Henvendelse {
  id        Int      @id @default(autoincrement())
  navn      String
  epost     String
  telefon   String?
  adresse   String?
  tilstand  String?
  melding   String
  lest      Boolean  @default(false)
  opprettet DateTime @default(now())
}
