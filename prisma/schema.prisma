generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Bolig {
  id          Int      @id @default(autoincrement())
  tittel      String
  adresse     String
  by          String
  pris        Int?
  type        String
  storrelse   Int?
  rom         Int?
  bad         Int?
  beskrivelse String
  bilder      String   @default("[]")
  lat         Float?
  lng         Float?
  aktiv       Boolean  @default(true)
  opprettet   DateTime @default(now())
  oppdatert   DateTime @updatedAt
  status                      String    @default("til_salgs")
  kjopesum                     Int?
  kjopsdato                    DateTime?
  finansiering                 String?
  estimertVerdiNa              Int?
  estimertVerdiEtterOppussing  Int?
  delprosjekter Delprosjekt[]
}

model AdminUser {
  id         Int      @id @default(autoincrement())
  brukernavn String   @unique
  passord    String
  navn       String
  rolle      String   @default("eier")
  opprettet  DateTime @default(now())
}

model Delprosjekt {
  id          Int      @id @default(autoincrement())
  eiendomId   Int
  eiendom     Bolig    @relation(fields: [eiendomId], references: [id])
  navn        String
  beskrivelse String?
  budsjett    Int?
  status      String   @default("planlagt")
  opprettet   DateTime @default(now())
  oppdatert   DateTime @updatedAt
}

model Henvendelse {
  id        Int      @id @default(autoincrement())
  navn      String
  epost     String
  telefon   String?
  adresse   String?
  tilstand  String?
  melding   String
  lest      Boolean  @default(false)
  opprettet DateTime @default(now())
}
