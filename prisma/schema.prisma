generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Bolig {
  id          Int      @id @default(autoincrement())
  tittel      String
  adresse     String
  by          String
  pris        Int?
  type        String
  storrelse   Int?
  rom         Int?
  bad         Int?
  beskrivelse String
  bilder      String   @default("[]")
  lat         Float?
  lng         Float?
  aktiv       Boolean  @default(true)
  opprettet   DateTime @default(now())
  oppdatert   DateTime @updatedAt
}

model AdminUser {
  id         Int      @id @default(autoincrement())
  brukernavn String   @unique
  passord    String
  opprettet  DateTime @default(now())
}
